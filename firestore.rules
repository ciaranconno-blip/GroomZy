rules_version = '2';

// Deploy via: firebase deploy --only firestore:rules
//
// Multi-tenant: every booking/enquiry/waitlist doc carries a denormalized
// ownerId (the owning business's Firebase Auth uid), so ownership checks are
// a plain field comparison — no get() needed on every read. onSnapshot
// listeners in app/admin/page.tsx pay that cost continuously, so keeping
// reads free matters more than keeping writes free.
//
// create IS allowed one get() — verifying the client-supplied ownerId
// actually matches businessId's real owner, so a booking can't be created
// with a spoofed ownerId that would silently inject data into another
// business's dashboard. This runs once per booking, not per read.

service cloud.firestore {
  match /databases/{database}/documents {

    match /businesses/{businessId} {
      allow read: if true; // public profile pages — no login for customers
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow create: if request.resource.data.businessId is string
                    && request.resource.data.ownerId ==
                       get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId;
      allow read, update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.businessId is string
                    && request.resource.data.ownerId ==
                       get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId;
      allow read, update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /waitlist/{entryId} {
      allow create: if request.resource.data.businessId is string
                    && request.resource.data.ownerId ==
                       get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId;
      allow read, update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /googleCalendarTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
